# Server Configuration
PORT=3000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tt_tracker?retryWrites=true&w=majority

# Academic Timezone
TZ=Asia/Kolkata

# Development Mode (true allows simulation parameter override, false for production)
DEV_MODE=false

# Server-to-server import secret (used by FATGS to hand off generated timetable)
TT_TRACKER_IMPORT_SECRET=your-secure-import-secret
