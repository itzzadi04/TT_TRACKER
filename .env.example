# TT_TRACKER Environment Configuration
# Copy this file to .env for local development. In production set these in the host's
# environment settings instead; never commit real values.

# Port the server listens on (hosts such as Render set this for you)
PORT=3000

# Set to "production" on the deployed service to get startup warnings about unsafe settings
# NODE_ENV=production

# MongoDB Atlas connection string. Use a dedicated database for the demo or production,
# never the one your tests write to.
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tt_tracker?retryWrites=true&w=majority

# Academic Timezone
TZ=Asia/Kolkata

# Development Mode (true allows simulation parameter override, false for production)
DEV_MODE=false

# Server-to-server import secret (used by FATGS to hand off the generated timetable).
# It must be identical to TT_TRACKER_IMPORT_SECRET on the FATGS side. In production use a
# long random value (at least 16 characters), for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TT_TRACKER_IMPORT_SECRET=replace-with-a-long-random-secret
